name: weblate

services:
  database:
    image: {{ weblate_postgres_image | to_json }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: weblate
      POSTGRES_USER: weblate
      POSTGRES_PASSWORD: {{ weblate_db_password | replace('$', '$$') | to_json }}
    volumes:
      - postgres-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U weblate -d weblate"]
      interval: 10s
      timeout: 5s
      retries: 10

  cache:
    image: {{ weblate_valkey_image | to_json }}
    restart: unless-stopped
    read_only: true
    command: ["valkey-server", "--save", "60", "1", "--loglevel", "warning"]
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10

  weblate:
    image: {{ weblate_image | to_json }}
    restart: unless-stopped
    read_only: true
    stop_grace_period: 120s
    depends_on:
      database:
        condition: service_healthy
      cache:
        condition: service_healthy
    environment:
      POSTGRES_HOST: database
      POSTGRES_DB: weblate
      POSTGRES_USER: weblate
      POSTGRES_PASSWORD: {{ weblate_db_password | replace('$', '$$') | to_json }}
      REDIS_HOST: cache
      WEBLATE_SITE_DOMAIN: {{ weblate_domain | to_json }}
      WEBLATE_ALLOWED_HOSTS: {{ weblate_domain | to_json }}
      WEBLATE_ENABLE_HTTPS: "1"
      WEBLATE_IP_PROXY_HEADER: HTTP_CF_CONNECTING_IP
      WEBLATE_TRUSTED_PROXY_ADDRESSES: {{ weblate_tunnel_address | to_json }}
      WEBLATE_REGISTRATION_OPEN: "0"
      WEBLATE_ADMIN_NAME: {{ weblate_admin_name | to_json }}
      WEBLATE_ADMIN_EMAIL: {{ weblate_admin_email | to_json }}
      WEBLATE_SERVER_EMAIL: {{ mailer_from_email | to_json }}
      WEBLATE_DEFAULT_FROM_EMAIL: {{ mailer_from_email | to_json }}
      WEBLATE_EMAIL_HOST: smtp-relay.brevo.com
      WEBLATE_EMAIL_PORT: "587"
      WEBLATE_EMAIL_USE_TLS: "1"
      WEBLATE_EMAIL_USE_SSL: "0"
      WEBLATE_EMAIL_HOST_USER: {{ weblate_smtp_user | replace('$', '$$') | to_json }}
      WEBLATE_EMAIL_HOST_PASSWORD: {{ weblate_smtp_password | replace('$', '$$') | to_json }}
      WEBLATE_WORKERS: "2"
    volumes:
      - ./data:/app/data
      - weblate-cache:/app/cache
    tmpfs:
      - /run
      - /tmp

  cloudflared:
    image: {{ weblate_cloudflared_image | to_json }}
    restart: unless-stopped
    command: tunnel --no-autoupdate run
    environment:
      TUNNEL_TOKEN: {{ weblate_cloudflare_tunnel_token | replace('$', '$$') | to_json }}
    networks:
      default:
        ipv4_address: {{ weblate_tunnel_address | to_json }}

networks:
  default:
    ipam:
      config:
        - subnet: {{ weblate_network_subnet | to_json }}

volumes:
  postgres-data:
  redis-data:
  weblate-cache:
