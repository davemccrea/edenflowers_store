<%= if @order.customer_first_name do %><%= dgettext("emails", "Hi %{name},", name: @order.customer_first_name) %><% else %><%= dgettext("emails", "Hi,") %><% end %>

<%= dgettext("emails", "A friendly reminder that %{amount} is still to pay for your order for %{date}.", amount: @format_currency.(@order.balance), date: @date) %>

<%= message(@message) %><%= order_totals(assigns) %>
<%= dgettext("emails", "You can pay online here:") %>
<%= @payment_link_url %>

<%= dgettext("emails", "If you've already paid, thank you, and please ignore this email.") %>

<%= dgettext("emails", "Warm wishes,") %>

<%= signature() %>
