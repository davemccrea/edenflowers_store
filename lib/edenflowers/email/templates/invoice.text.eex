<%= if @first_name do %><%= dgettext("emails", "Hi %{name},", name: @first_name) %><% else %><%= dgettext("emails", "Hi,") %><% end %>

<%= dgettext("emails", "Invoice %{number} is attached.", number: @invoice.number) %>

<%= cond do %><% @reminder? and @part_paid? -> %><%= dgettext("emails", "Just a friendly reminder that it was due on %{date}, and %{amount} of it is still to pay. Thank you for what you've paid so far.", date: @format_weekday_date.(@invoice.due_date), amount: @format_currency.(@invoice.amount_unpaid)) %>

<% @reminder? -> %><%= dgettext("emails", "Just a friendly reminder that it was due on %{date}, and I haven't seen the payment yet. If you've already paid, thank you, and please ignore this email.", date: @format_weekday_date.(@invoice.due_date)) %>

<% @part_paid? -> %><%= dgettext("emails", "Thank you for your payment. There is %{amount} still to pay.", amount: @format_currency.(@invoice.amount_unpaid)) %>

<% true -> %><% end %><%= dgettext("emails", "If anything on it looks wrong, just reply to this email.") %>

<%= dgettext("emails", "Warm wishes,") %>

<%= signature() %>
