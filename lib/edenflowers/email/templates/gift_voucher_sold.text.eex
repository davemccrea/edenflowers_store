<%= if @order.customer_first_name do %><%= dgettext("emails", "Hi %{name},", name: @order.customer_first_name) %><% else %><%= dgettext("emails", "Hi,") %><% end %>

<%= dgettext("emails", "Thank you for buying a gift voucher! The voucher for %{recipient} is attached, ready to print or forward.", recipient: @order.recipient_name) %>
<%= if @ready_on do %>
<%= dgettext("emails", "I'll have a gift card with the voucher written on it ready for you to collect at %{shop} from %{date}.", shop: shop_address(), date: @ready_on) %>
<% end %>
<%= dgettext("emails", "Gift voucher: %{amount}", amount: @amount) %>
<%= dgettext("emails", "Code: %{code}", code: @code) %>
<%= dgettext("emails", "Valid until %{date}", date: @expires_on) %>

<%= dgettext("emails", "It can be spent on flowers, subscriptions and courses, online or in the shop. Your receipt is attached too. If you have a question, reply to this email.") %>

<%= dgettext("emails", "Warm wishes,") %>

<%= signature() %>
