<%= if @registration.first_name do %><%= dgettext("emails", "Hi %{name},", name: @registration.first_name) %><% else %><%= dgettext("emails", "Hi,") %><% end %>

<%= dngettext("emails", "Thank you for booking. Your place on %{course} is confirmed.", "Thank you for booking. Your %{count} places on %{course} are confirmed.", @registration.seats, course: @registration.course.name) %>

<%= message(@message) %><%= dgettext("emails", "When: %{date}, %{start}–%{end}", date: @format_date.(@registration.course.date), start: @format_time.(@registration.course.start_time), end: @format_time.(@registration.course.end_time)) %>
<%= dgettext("emails", "Where: %{venue}, %{address}", venue: @registration.course.location_name, address: @registration.course.location_address) %><%= if Decimal.positive?(@registration.amount_paid) do %>

<%= dgettext("emails", "Your receipt is attached.") %><% end %><%= if Decimal.positive?(@registration.balance) do %>

<%= course_payment(assigns) |> String.trim() %><% end %>

<%= dgettext("emails", "To cancel, reply to this email.") %> <%= Edenflowers.Courses.Course.cancellation_terms(@registration.course) %>

<%= dgettext("emails", "See you there,") %>

<%= signature() %>
