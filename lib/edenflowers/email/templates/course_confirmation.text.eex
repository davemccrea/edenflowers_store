<%= if @registration.first_name do %><%= gettext("Hi %{name},", name: @registration.first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= if @course_over? do %><%= gettext("Thank you for coming to %{course}.", course: @registration.course.name) %>

<% else %><%= ngettext("Thank you for booking. Your place on %{course} is confirmed.", "Thank you for booking. Your %{count} places on %{course} are confirmed.", @registration.seats, course: @registration.course.name) %>

<%= gettext("When: %{date}, %{start}–%{end}", date: @format_date.(@registration.course.date), start: @format_time.(@registration.course.start_time), end: @format_time.(@registration.course.end_time)) %>
<%= gettext("Where: %{venue}, %{address}", venue: @registration.course.location_name, address: @registration.course.location_address) %>

<% end %><%= gettext("Your receipt is attached.") %>

<%= unless @course_over? do %><%= if Decimal.positive?(@registration.amount_paid) do %><%= gettext("To cancel, reply to this email. Let me know at least 7 days before the course for a full refund. After that, we'll work something out.") %><% else %><%= gettext("If you need to cancel, reply to this email. Please let me know at least 7 days before the course if you can.") %><% end %>

<% end %><%= if @course_over?, do: gettext("Warm wishes,"), else: gettext("See you there,") %>

<%= signature() %>
