<%= if @registration.first_name do %><%= gettext("Hi %{name},", name: @registration.first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= ngettext("Thank you for booking. Your place on %{course} is confirmed.", "Thank you for booking. Your %{count} places on %{course} are confirmed.", @registration.seats, course: @registration.course.name) %>

<%= gettext("When: %{date}, %{start}–%{end}", date: @format_date.(@registration.course.date), start: @format_time.(@registration.course.start_time), end: @format_time.(@registration.course.end_time)) %>
<%= gettext("Where: %{venue}, %{address}", venue: @registration.course.location_name, address: @registration.course.location_address) %>
<%= if Decimal.positive?(@registration.balance) do %><%= gettext("Amount due") %>: <%= @format_currency.(@registration.balance) %>
<% end %>
<%= cond do %><% @payment_link_url -> %><%= gettext("You can pay online here, by card or MobilePay:") %>
<%= @payment_link_url %>

<%= gettext("Or pay at the course if you prefer.") %> <% Decimal.positive?(@registration.balance) -> %><%= gettext("You pay at the course.") %> <% true -> %><%= gettext("Your receipt is attached.") %> <% end %><%= cond do %><% Decimal.positive?(@registration.balance) -> %><%= gettext("If your plans change, just reply and let me know at least 7 days before the course.") %><% Decimal.positive?(@registration.course.late_cancellation_fee) -> %><%= gettext("If your plans change, just reply at least 7 days before the course and I'll refund you in full. After that, I keep %{fee} of the booking as a late-cancellation fee.", fee: @format_currency.(@registration.course.late_cancellation_fee)) %><% true -> %><%= gettext("If your plans change, just reply at least 7 days before the course and I'll refund you in full.") %><% end %>

<%= gettext("See you there,") %>

<%= signature() %>
