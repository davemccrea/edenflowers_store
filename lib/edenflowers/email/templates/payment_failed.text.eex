<%= if @order.customer_first_name do %><%= gettext("Hi %{name},", name: @order.customer_first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= gettext("Unfortunately, the payment for your next subscription order didn't go through on your saved card. This can happen when a card has expired or been replaced.") %>

<%= if @order.fulfillment_method == :delivery do %><%= gettext("Your flowers are still coming: I'll deliver them on %{date} to %{address}.", date: @format_date.(@order.fulfillment_date), address: @order.delivery_address) %><% else %><%= gettext("Your flowers will still be ready to collect on %{date} from %{shop}.", date: @format_date.(@order.fulfillment_date), shop: shop_address()) %><% end %>
<%= gettext("Amount due") %>: <%= @format_currency.(@order.grand_total) %>

<%= gettext("You can pay online here, by card or MobilePay:") %>
<%= @payment_link_url %>

<%= gettext("I've put your later deliveries on hold until this one is paid. Once it is, your subscription carries on as before from the next date. To keep this from happening again, you can update your saved card from your account:") %>
<%= @account_url %>

<%= gettext("If anything needs changing, just reply and I'll take care of it.") %>

<%= gettext("Warm wishes,") %>

<%= signature() %>
