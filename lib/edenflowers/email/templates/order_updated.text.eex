<%= if @order.customer_first_name do %><%= dgettext("emails", "Hi %{name},", name: @order.customer_first_name) %><% else %><%= dgettext("emails", "Hi,") %><% end %>

<%= dgettext("emails", "I've updated your order.") %>

<%= message(@message) %><%= order_totals(assigns) %>
<%= order_fulfillment(assigns) %><%= if Decimal.positive?(@order.balance) do %><%= order_payment(assigns) %><% end %><%= dgettext("emails", "If anything doesn't look right, just reply.") %>

<%= dgettext("emails", "Warm wishes,") %>

<%= signature() %>
