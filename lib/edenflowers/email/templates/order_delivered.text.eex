<%= if @order.customer_first_name, do: ~t"Hi #{name = @order.customer_first_name},", else: ~t"Hi," %>

<%= if @order.gift && @order.recipient_first_name, do: ~t"Your order for #{recipient = @order.recipient_first_name} has been delivered.", else: ~t"Your order has been delivered." %>

<%= message(@message) %><%= ~t"Thank you for your order. If anything isn't as it should be, just reply and I'll take care of it." %>

<%= ~t"Warm wishes," %>

<%= signature() %>
