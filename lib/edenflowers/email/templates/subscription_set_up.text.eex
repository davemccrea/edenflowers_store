<%= if @subscription.user.first_name do %><%= gettext("Hi %{name},", name: @subscription.user.first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= gettext("Thank you for subscribing!") %>

<%= gettext("Size") %>: <%= @size %>
<%= gettext("How often") %>: <%= @interval %>
<%= if @pickup? do %><%= gettext("Price per pickup") %>: <%= @price %>
<%= gettext("Collect from") %>: <%= shop_address() %>
<%= gettext("First pickup") %><% else %><%= gettext("Price per delivery") %>: <%= @price %>
<%= gettext("Delivered to") %>: <%= @subscription.delivery_address %>
<%= gettext("First delivery") %><% end %>: <%= @format_date.(@subscription.first_delivery_date) %>
<%= gettext("Then") %>: <%= @format_date.(@subscription.next_fulfillment_date) %>
<%= if @subscription.first_order_discounted? || @subscription.card_message do %>
<%= if @subscription.first_order_discounted? do %><%= gettext("Your promo code discount was for the first order only. Later orders are at the price above.") %>
<% end %><%= if @subscription.card_message do %><%= gettext("Your card message goes with the first order only.") %>
<% end %><% end %>
<%= if @pickup? do %><%= gettext("The first order's receipt is in a separate email. After that, I charge your saved card %{days} days before each pickup.", days: @charge_days) %><% else %><%= gettext("The first order's receipt is in a separate email. After that, I charge your saved card %{days} days before each delivery.", days: @charge_days) %><% end %>

<%= gettext("You can pause, change the size or how often, update your payment card or cancel from your account:") %>
<%= @account_url %>

<%= gettext("If anything needs changing, just reply and I'll take care of it.") %>

<%= gettext("Warm wishes,") %>

<%= signature() %>
