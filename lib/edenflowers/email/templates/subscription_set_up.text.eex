<%= if @subscription.user.first_name do %><%= gettext("Hi %{name},", name: @subscription.user.first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= gettext("Thank you for subscribing!") %>

<%= gettext("Size") %>: <%= @size %>
<%= gettext("How often") %>: <%= @interval %>
<%= if @pickup? do %><%= gettext("First pickup") %><% else %><%= gettext("Delivered to") %>: <%= @subscription.delivery_address %>
<%= gettext("First delivery") %><% end %>: <%= @format_date.(@subscription.first_delivery_date) %>
<%= gettext("Then") %>: <%= @format_date.(@subscription.next_fulfillment_date) %>
<%= if @subscription.first_order_discounted? do %>
<%= gettext("The discount applies to your first order.") %>
<% end %>
<%= if @subscription.card_message do %>
<%= gettext("Your card message comes with the first order.") %>
<% end %>
<%= if @pickup? do %><%= gettext("The first order's receipt is in a separate email. After that, I charge your saved card a few days before each pickup.") %><% else %><%= gettext("The first order's receipt is in a separate email. After that, I charge your saved card a few days before each delivery.") %><% end %>

<%= gettext("You can pause, change the size or how often, update your payment card or cancel from your account:") %>
<%= @account_url %>

<%= gettext("If anything needs changing, just reply and I'll take care of it.") %>

<%= gettext("Warm wishes,") %>

Jennie
Eden Flowers
