<%= if @pickup? do %><%= dgettext("emails", "Your next flowers (%{product}) will be ready to collect on %{date}, at %{address}.", product: @product, date: @format_date.(@subscription.next_fulfillment_date), address: shop_address()) %><% else %><%= dgettext("emails", "Your next %{product} delivery is on %{date}, to %{address}.", product: @product, date: @format_date.(@subscription.next_fulfillment_date), address: @subscription.delivery_address) %><% end %>

<%= dgettext("emails", "Away, or want a change? Pause or change it in your account by %{date}:", date: @format_date.(@change_by)) %>
<%= @account_url %>

<%= dgettext("emails", "Your next flowers cost %{total}. On %{date}, we'll apply your available gift voucher balance and charge any remaining amount to your card.", total: @price, date: @format_date.(@charged_on)) %>

Eden Flowers
