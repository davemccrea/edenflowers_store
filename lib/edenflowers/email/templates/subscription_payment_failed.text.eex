<%= if @order.customer_first_name do %><%= dgettext("emails", "Hi %{name},", name: @order.customer_first_name) %><% else %><%= dgettext("emails", "Hi,") %><% end %>

<%= dgettext("emails", "The payment for your flowers on %{date} (%{product}) didn't go through. Please pay %{amount} using the link below:", product: @product, date: @date, amount: @format_currency.(@order.balance)) %>
<%= @payment_link_url %>

<%= dgettext("emails", "Later deliveries are on hold until this one is paid. To keep them coming, please also update your card in your account:") %>
<%= @account_url %>

<%= dgettext("emails", "If you need help with the payment, just reply to this email.") %>

<%= dgettext("emails", "Warm wishes,") %>

<%= signature() %>
