<%= if @order.customer_first_name do %><%= dgettext("emails", "Hi %{name},", name: @order.customer_first_name) %><% else %><%= dgettext("emails", "Hi,") %><% end %>

<%= dgettext("emails", "The payment for your order for %{date} (%{product}) didn't go through, but your order will still go ahead as planned.", product: @product, date: @date) %>

<%= dgettext("emails", "Please pay %{amount} using the link below:", amount: @format_currency.(@order.balance)) %>
<%= @payment_link_url %>

<%= dgettext("emails", "Future orders are on hold until this one is paid. Please also update your saved card in your account:") %>
<%= @account_url %>

<%= dgettext("emails", "If you need help with the payment, just reply to this email.") %>

<%= dgettext("emails", "Warm wishes,") %>

<%= signature() %>
