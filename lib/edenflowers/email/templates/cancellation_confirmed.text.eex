<%= dgettext("emails", "Your order %{reference} for %{date} is cancelled.", reference: @order.order_reference, date: @format_date.(@order.fulfillment_date)) %>
<%= if Decimal.positive?(@refunded) do %>
<%= case @refunded_to do %><% {:card, brand, last4} -> %><%= dgettext("emails", "Refund: %{amount} to %{brand} •••• %{last4}", amount: @format_currency.(@refunded), brand: brand, last4: last4) %><% :mobilepay -> %><%= dgettext("emails", "Refund: %{amount} to MobilePay", amount: @format_currency.(@refunded)) %><% :unknown -> %><%= dgettext("emails", "Refund: %{amount}, the way you paid", amount: @format_currency.(@refunded)) %><% end %>
<%= dgettext("emails", "Refunds usually take 3–5 working days to appear on your statement.") %>
<% end %>
<%= dgettext("emails", "Questions? Reply to this email.") %>

Eden Flowers
