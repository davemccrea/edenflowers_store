<%= if @registration.first_name do %><%= dgettext("emails", "Hi %{name},", name: @registration.first_name) %><% else %><%= dgettext("emails", "Hi,") %><% end %>

<%= dgettext("emails", "There's %{amount} still to pay for your booking on %{course}, %{date}. You can pay using the link below:", amount: @format_currency.(@registration.balance), course: @registration.course.name, date: @format_date.(@registration.course.date)) %>
<%= @payment_link_url %>

<%= dgettext("emails", "If you've already paid, thank you, and please ignore this email.") %>

<%= dgettext("emails", "Warm wishes,") %>

<%= signature() %>
