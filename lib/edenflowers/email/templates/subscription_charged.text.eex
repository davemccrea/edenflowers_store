<%= if Decimal.positive?(@order.amount_paid) do %><%= if Decimal.positive?(@card_amount) do %><%= if @order.fulfillment_method == :delivery do %><%= dgettext("emails", "Your card was charged %{amount} for your delivery scheduled for %{date} (%{product}). Your receipt is attached.", amount: @format_currency.(@card_amount), product: @product, date: @date) %><% else %><%= dgettext("emails", "Your card was charged %{amount} for your order for collection on %{date} (%{product}). Your receipt is attached.", amount: @format_currency.(@card_amount), product: @product, date: @date) %><% end %><%= if Decimal.positive?(@voucher_amount) do %>
<%= dgettext("emails", "Paid with your gift voucher: %{amount}.", amount: @format_currency.(@voucher_amount)) %><% end %><% else %><%= if @order.fulfillment_method == :delivery do %><%= dgettext("emails", "Your gift voucher paid %{amount} for your delivery scheduled for %{date} (%{product}). Your receipt is attached.", amount: @format_currency.(@voucher_amount), product: @product, date: @date) %><% else %><%= dgettext("emails", "Your gift voucher paid %{amount} for your order for collection on %{date} (%{product}). Your receipt is attached.", amount: @format_currency.(@voucher_amount), product: @product, date: @date) %><% end %><% end %><% else %><%= dgettext("emails", "Thank you for your purchase. Your receipt is attached.") %><% end %>

<%= dgettext("emails", "To pause, change or cancel your subscription, use your account:") %>
<%= @account_url %>

Eden Flowers
