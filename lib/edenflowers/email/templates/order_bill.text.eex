<%= if @order.customer_first_name do %><%= gettext("Hi %{name},", name: @order.customer_first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= gettext("Thank you for your order. I hope you're happy with it. Here are the details:") %>

<%= order_totals(assigns) %>
<%= cond do %><% @payment_link_url -> %><%= gettext("You can pay online here, by card or MobilePay:") %>
<%= @payment_link_url %>

<% Decimal.positive?(@order.balance) and @order.payment_terms == :invoice -> %><%= gettext("I'll send you an invoice.") %>

<% true -> %><% end %><%= gettext("If anything isn't as it should be, just reply and I'll take care of it.") %>

<%= gettext("Warm wishes,") %>

<%= signature() %>
