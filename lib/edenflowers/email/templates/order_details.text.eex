<%= if @order.customer_first_name do %><%= gettext("Hi %{name},", name: @order.customer_first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= gettext("Thank you for your order. Here is what we agreed:") %>

<%= message(@message) %><%= order_totals(assigns) %>
<%= order_fulfillment(assigns) %><%= order_payment(assigns) %><%= gettext("If you need to change anything, reply and I'll let you know what's possible.") %>

<%= gettext("Warm wishes,") %>

<%= signature() %>
