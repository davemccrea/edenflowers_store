<%= if @order.customer_first_name do %><%= gettext("Hi %{name},", name: @order.customer_first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= if @order.order_details_emailed_at || @order.origin != :custom do %><%= gettext("Here are your order details:") %><% else %><%= gettext("Thank you for your order. Here is what we agreed:") %><% end %>

<%= order_totals(assigns) %>
<%= if @order.fulfillment_method == :delivery do %><%= gettext("Delivery on %{date} to %{address}", date: @fulfillment_on, address: @order.delivery_address) %><% else %><%= gettext("Collect on %{date} from %{shop}", date: @fulfillment_on, shop: shop_address()) %><% end %>
<%= if @order.recipient_name do %><%= gettext("For %{recipient}", recipient: @order.recipient_name) %>
<% end %>
<%= cond do %><% @payment_link_url -> %><%= gettext("You can pay online here, by card or MobilePay:") %>
<%= @payment_link_url %>

<% not Decimal.positive?(@order.balance) -> %><% @order.payment_terms == :invoice and @order.fulfillment_method == :delivery -> %><%= gettext("I'll send you an invoice after delivery.") %>

<% @order.payment_terms == :invoice -> %><%= gettext("I'll send you an invoice after you've collected your order.") %>

<% @order.payment_terms == :on_fulfillment and @order.fulfillment_method == :delivery -> %><%= gettext("You pay on delivery.") %>

<% @order.payment_terms == :on_fulfillment -> %><%= gettext("You pay when you collect your order.") %>

<% true -> %><% end %><%= gettext("If you need to change anything, reply and I'll let you know what's possible.") %>

<%= gettext("Warm wishes,") %>

<%= signature() %>
