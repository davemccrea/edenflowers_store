<%= if @order.customer_first_name do %><%= gettext("Hi %{name},", name: @order.customer_first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= case @state do %><% :bill -> %><%= gettext("Thank you for your order. I hope you're happy with it. Here are the details:") %><% :card_refused -> %><%= gettext("The payment for your next subscription order didn't go through on your saved card, but your flowers are still coming.") %><% :details -> %><%= if @order.order_details_emailed_at || @order.origin != :custom do %><%= gettext("Here are your order details:") %><% else %><%= gettext("Thank you for your order. Here is what we agreed:") %><% end %><% end %>

<%= order_totals(assigns) %>
<%= if @state != :bill do %><%= if @order.fulfillment_method == :delivery do %><%= gettext("Delivery on %{date} to %{address}", date: @fulfillment_on, address: @order.delivery_address) %><% else %><%= gettext("Collect on %{date} from %{shop}", date: @fulfillment_on, shop: shop_address()) %><% end %>
<%= if @order.recipient_name do %><%= gettext("For %{recipient}", recipient: @order.recipient_name) %>
<% end %>
<% end %><%= cond do %><% @payment_link_url -> %><%= gettext("You can pay online here, by card or MobilePay:") %>
<%= @payment_link_url %>

<% not Decimal.positive?(@order.balance) -> %><% @order.payment_terms == :invoice and @state == :bill -> %><%= gettext("I'll send you an invoice.") %>

<% @state == :bill -> %><% @order.payment_terms == :invoice and @order.fulfillment_method == :delivery -> %><%= gettext("I'll send you an invoice after delivery.") %>

<% @order.payment_terms == :invoice -> %><%= gettext("I'll send you an invoice after you've collected your order.") %>

<% @order.payment_terms == :on_fulfillment and @order.fulfillment_method == :delivery -> %><%= gettext("You pay on delivery.") %>

<% @order.payment_terms == :on_fulfillment -> %><%= gettext("You pay when you collect your order.") %>

<% true -> %><% end %><%= if @state == :card_refused do %><%= gettext("Future subscription orders are on hold. Paying this order restarts your subscription.") %>

<%= gettext("You can also update your saved card from your account. Updating it restarts future orders, but you still need to pay this order using the link above:") %>
<%= @account_url %>

<% end %><%= case @state do %><% :bill -> %><%= gettext("If anything isn't as it should be, just reply and I'll take care of it.") %><% :card_refused -> %><%= gettext("If you need help with the payment, reply to this email.") %><% :details -> %><%= gettext("If you need to change anything, reply and I'll let you know what's possible.") %><% end %>

<%= gettext("Warm wishes,") %>

<%= signature() %>
