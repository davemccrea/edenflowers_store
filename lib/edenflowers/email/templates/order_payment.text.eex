<%= cond do %><% @payment_link_url -> %><%= dgettext("emails", "You can pay online here:") %>
<%= @payment_link_url %>

<% not Decimal.positive?(@order.balance) -> %><% @order.payment_terms == :invoice and @order.fulfillment_method == :delivery -> %><%= dgettext("emails", "I'll send you an invoice after delivery.") %>

<% @order.payment_terms == :invoice -> %><%= dgettext("emails", "I'll send you an invoice after you've collected your order.") %>

<% @order.payment_terms == :on_fulfillment and @order.fulfillment_method == :delivery -> %><%= dgettext("emails", "You pay on delivery.") %>

<% @order.payment_terms == :on_fulfillment -> %><%= dgettext("emails", "You pay when you collect your order.") %>

<% true -> %><% end %>