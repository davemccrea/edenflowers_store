<%= if @order.customer_first_name do %><%= gettext("Hi %{name},", name: @order.customer_first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= gettext("Your order for %{date} is cancelled.", date: @format_date.(@order.fulfillment_date)) %>

<%= if Decimal.positive?(@refunded) do %><%= case @refunded_to do %><% {:card, brand, last4} -> %><%= gettext("I've refunded %{amount} to your %{brand} card ending in %{last4}. It can take 5–10 days to show on your statement.", amount: @format_currency.(@refunded), brand: brand, last4: last4) %><% :mobilepay -> %><%= gettext("I've refunded %{amount} to your MobilePay. It can take a few days to show.", amount: @format_currency.(@refunded)) %><% :unknown -> %><%= gettext("I've refunded %{amount} the way you paid. It can take 5–10 days to show.", amount: @format_currency.(@refunded)) %><% end %>

<% end %><%= gettext("If you didn't mean to cancel, just reply and I'll take care of it.") %>

<%= gettext("Warm wishes,") %>

<%= signature() %>
