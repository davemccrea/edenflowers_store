<%= if @order.customer_first_name do %><%= gettext("Hi %{name},", name: @order.customer_first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= gettext("Your order for %{date} is cancelled.", date: @format_date.(@order.fulfillment_date)) %>

<%= message(@message) %><%= if Decimal.positive?(@refunded) do %><%= refund_line(%{amount: @refunded, how: @refunded_to, format_currency: @format_currency}) %>

<% end %><%= if Decimal.positive?(@to_return) do %><%= if Decimal.positive?(@refunded) do %><%= gettext("I'll pay back the other %{amount} the same way you paid it.", amount: @format_currency.(@to_return)) %><% else %><%= gettext("I'll pay back %{amount} the same way you paid it.", amount: @format_currency.(@to_return)) %><% end %>

<% end %><%= gettext("If you have any questions, just reply to this email.") %>

<%= gettext("Warm wishes,") %>

<%= signature() %>
