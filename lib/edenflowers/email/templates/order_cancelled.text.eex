<%= if @order.customer_first_name do %><%= gettext("Hi %{name},", name: @order.customer_first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= gettext("Your order for %{date} is cancelled.", date: @format_date.(@order.fulfillment_date)) %>

<%= if Decimal.positive?(@refunded) do %><%= case @refunded_to do %><% {:card, brand, last4} -> %><%= gettext("I've refunded %{amount} to your %{brand} card ending in %{last4}.", amount: @format_currency.(@refunded), brand: brand, last4: last4) %><% :mobilepay -> %><%= gettext("I've refunded %{amount} to your MobilePay.", amount: @format_currency.(@refunded)) %><% :unknown -> %><%= gettext("I've refunded %{amount} the way you paid.", amount: @format_currency.(@refunded)) %><% end %>

<% end %><%= gettext("If you didn't mean to cancel, reply and I'll help you arrange a new order.") %>

<%= gettext("Warm wishes,") %>

<%= signature() %>
