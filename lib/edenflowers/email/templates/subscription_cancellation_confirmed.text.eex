<%= gettext("Your %{product} subscription is cancelled. Your card won't be charged again.", product: @product) %>
<%= if @charged_on do %>
<%= if @pickup? do %><%= gettext("Your order has already been charged and will still be ready to collect on %{date}.", date: @format_date.(@charged_on)) %><% else %><%= gettext("Your delivery on %{date} has already been charged and will still come.", date: @format_date.(@charged_on)) %><% end %>
<% end %>
<%= gettext("Questions? Reply to this email.") %>

Eden Flowers
