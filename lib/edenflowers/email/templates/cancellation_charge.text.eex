<%= cond do %><% Decimal.eq?(@to_collect, 0) -> %><%= dgettext("emails", "I've kept %{amount} as a cancellation charge.", amount: @format_currency.(@charge)) %><% Decimal.eq?(@to_collect, @charge) -> %><%= dgettext("emails", "There's a cancellation charge of %{amount}.", amount: @format_currency.(@charge)) %> <%= collect_line(assigns) %><% true -> %><%= dgettext("emails", "There's a cancellation charge of %{charge}, and %{amount} of it is still to pay.", charge: @format_currency.(@charge), amount: @format_currency.(@to_collect)) %> <%= collect_line(assigns) %><% end %>