<%= if @registration.first_name do %><%= gettext("Hi %{name},", name: @registration.first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= gettext("You have %{balance} left to pay for %{course}.", balance: @format_currency.(@registration.balance), course: @registration.course.name) %>

<%= gettext("Pay online by card or MobilePay:") %>
<%= @payment_link_url %>

<%= gettext("Or pay at the course if you prefer.") %>

<%= gettext("When: %{date}, %{start}–%{end}", date: @format_date.(@registration.course.date), start: @format_time.(@registration.course.start_time), end: @format_time.(@registration.course.end_time)) %>
<%= gettext("Where: %{venue}, %{address}", venue: @registration.course.location_name, address: @registration.course.location_address) %>
<%= if Decimal.positive?(@registration.amount_paid) and Decimal.positive?(@registration.course.late_cancellation_fee) do %><%= gettext("To cancel, reply at least 7 days before the course. If you cancel later, I keep up to %{fee} of what you've paid as a cancellation fee.", fee: @format_currency.(@registration.course.late_cancellation_fee)) %><% else %><%= gettext("If you need to cancel, reply to this email. Please let me know at least 7 days before the course if you can.") %><% end %>

<%= gettext("See you there,") %>

<%= signature() %>
