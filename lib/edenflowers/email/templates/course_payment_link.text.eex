<%= if @registration.first_name do %><%= gettext("Hi %{name},", name: @registration.first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= ngettext("Here's the link to pay for your place on %{course}. Your place is booked as soon as you've paid.", "Here's the link to pay for your %{count} places on %{course}. They're booked as soon as you've paid.", @registration.seats, course: @registration.course.name) %>

<%= message(@message) %><%= gettext("Amount due") %>: <%= @format_currency.(@registration.balance) %>

<%= gettext("You can pay online here:") %>
<%= @payment_link_url %>

<%= gettext("When: %{date}, %{start}–%{end}", date: @format_date.(@registration.course.date), start: @format_time.(@registration.course.start_time), end: @format_time.(@registration.course.end_time)) %>
<%= gettext("Where: %{venue}, %{address}", venue: @registration.course.location_name, address: @registration.course.location_address) %>

<%= gettext("To cancel, reply to this email.") %> <%= Edenflowers.Courses.Course.cancellation_terms(@registration.course) %>

<%= gettext("See you there,") %>

<%= signature() %>
