<%= if @registration.first_name do %><%= gettext("Hi %{name},", name: @registration.first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= gettext("You can pay for your booking on %{course} online, by card or MobilePay:", course: @registration.course.name) %>
<%= @payment_link_url %>

<%= gettext("When: %{date}, %{start}–%{end}", date: @format_date.(@registration.course.date), start: @format_time.(@registration.course.start_time), end: @format_time.(@registration.course.end_time)) %>
<%= gettext("Where: %{venue}, %{address}", venue: @registration.course.location_name, address: @registration.course.location_address) %>
<%= gettext("Amount due") %>: <%= @format_currency.(@registration.balance) %>

<%= gettext("Or pay at the course if you prefer.") %> <%= gettext("If your plans change, just reply and let me know at least 7 days before the course.") %>

<%= gettext("See you there,") %>

<%= signature() %>
