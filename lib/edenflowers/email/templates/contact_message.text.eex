<%= if @first_name do %><%= dgettext("emails", "Hi %{name},", name: @first_name) %><% else %><%= dgettext("emails", "Hi,") %><% end %>

<%= dgettext("emails", "Thank you for your message. I'll get back to you as soon as I can.") %>

<%= dgettext("emails", "Here's a copy of what you sent:") %>

<%= dgettext("emails", "Name: %{name}", name: @message["name"]) %>
<%= dgettext("emails", "Email: %{email}", email: @message["email"]) %>
<%= if @message["phone"] do %><%= dgettext("emails", "Phone: %{phone}", phone: @message["phone"]) %>
<% end %>
<%= dgettext("emails", "Your message:") %>
<%= @message["message"] %>

<%= dgettext("emails", "Warm wishes,") %>

<%= signature() %>
