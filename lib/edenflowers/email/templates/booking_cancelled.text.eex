<%= if @registration.first_name do %><%= dgettext("emails", "Hi %{name},", name: @registration.first_name) %><% else %><%= dgettext("emails", "Hi,") %><% end %>

<%= dgettext("emails", "Your booking on %{course} on %{date} is cancelled.", course: @registration.course.name, date: @format_date.(@registration.course.date)) %>

<%= if Decimal.positive?(@charge) do %><%= cancellation_charge(assigns) %>

<% end %><%= if Decimal.positive?(@refunded) do %><%= refund_line(%{amount: @refunded, how: @refunded_to, format_currency: @format_currency}) %>

<% end %><%= if Decimal.positive?(@back_on_voucher) do %><%= dgettext("emails", "I've put %{amount} back on your gift voucher.", amount: @format_currency.(@back_on_voucher)) %>

<% end %><%= if Decimal.positive?(@to_return) do %><%= dgettext("emails", "I'll pay back %{amount} the same way you paid it.", amount: @format_currency.(@to_return)) %>

<% end %><%= dgettext("emails", "If you have any questions, just reply to this email.") %>

<%= dgettext("emails", "Warm wishes,") %>

<%= signature() %>
