<%= if @registration.first_name do %><%= dgettext("emails", "Hi %{name},", name: @registration.first_name) %><% else %><%= dgettext("emails", "Hi,") %><% end %>

<%= refund_line(%{amount: @refund.amount, how: @refunded_to, format_currency: @format_currency}) %>

<%= dgettext("emails", "Booking %{reference}: %{course}, %{date}", reference: @registration.reference, course: @registration.course.name, date: @format_date.(@registration.course.date)) %>

<%= dgettext("emails", "If you have any questions, just reply to this email.") %>

<%= dgettext("emails", "Warm wishes,") %>

<%= signature() %>
