<%= if @registration.first_name do %><%= gettext("Hi %{name},", name: @registration.first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= gettext("This is about your booking on %{course} on %{date}.", course: @registration.course.name, date: @format_date.(@registration.course.date)) %>

<%= if @refund.note do %><%= @refund.note %>

<% end %><%= if @refund.payment_method == :stripe do %><%= case @refunded_to do %><% {:card, brand, last4} -> %><%= gettext("I've refunded %{amount} to your %{brand} card ending in %{last4}.", amount: @format_currency.(@refund.amount), brand: brand, last4: last4) %><% :mobilepay -> %><%= gettext("I've refunded %{amount} to your MobilePay.", amount: @format_currency.(@refund.amount)) %><% :unknown -> %><%= gettext("I've refunded %{amount} the way you paid.", amount: @format_currency.(@refund.amount)) %><% end %><% else %><%= gettext("I've given you back %{amount}.", amount: @format_currency.(@refund.amount)) %><% end %>

<%= gettext("If you have any questions, just reply to this email.") %>

<%= gettext("Warm wishes,") %>

<%= signature() %>
