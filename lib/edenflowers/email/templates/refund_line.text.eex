<%= case @how do %><% {:card, brand, last4} -> %><%= dgettext("emails", "I've refunded %{amount} to your %{brand} card ending in %{last4}. It can take a few days to show on your statement.", amount: @format_currency.(@amount), brand: brand, last4: last4) %><% :mobilepay -> %><%= dgettext("emails", "I've refunded %{amount} to your MobilePay. It can take a few days to show on your statement.", amount: @format_currency.(@amount)) %><% :unknown -> %><%= dgettext("emails", "I've refunded %{amount} the way you paid. It can take a few days to show on your statement.", amount: @format_currency.(@amount)) %><% :zettle -> %><%= dgettext("emails", "I've refunded %{amount} to your card. It can take a few days to show on your statement.", amount: @format_currency.(@amount)) %><% :cash -> %><%= dgettext("emails", "I've refunded %{amount} in cash.", amount: @format_currency.(@amount)) %><% :mobilepay_transfer -> %><%= dgettext("emails", "I've refunded %{amount} to your MobilePay.", amount: @format_currency.(@amount)) %><% :zervant -> %><%= dgettext("emails", "I've refunded %{amount} to your bank account.", amount: @format_currency.(@amount)) %><% end %>