<%= dgettext("emails", "Name: %{name}", name: @enquiry["name"]) %>
<%= dgettext("emails", "Email: %{email}", email: @enquiry["email"]) %>
<%= dgettext("emails", "Wedding date: %{date}", date: @wedding_date) %>
<%= if @enquiry["venue"] do %><%= dgettext("emails", "Venue: %{venue}", venue: @enquiry["venue"]) %>
<% end %><%= if @enquiry["guests"] do %><%= dgettext("emails", "Number of guests: %{guests}", guests: @enquiry["guests"]) %>
<% end %><%= if @enquiry["selection"] != [] do %>
<%= dgettext("emails", "Flowers you're interested in:") %>
<%= for line <- @enquiry["selection"] do %>- <%= line %>
<% end %><%= dgettext("emails", "Rough estimate, not a quote: %{estimate}", estimate: @enquiry["estimate"]) %>
<% end %><%= if @enquiry["message"] do %>
<%= dgettext("emails", "Message:") %>
<%= @enquiry["message"] %>
<% end %>