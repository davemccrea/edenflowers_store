<%= if @order.customer_first_name do %><%= dgettext("emails", "Hi %{name},", name: @order.customer_first_name) %><% else %><%= dgettext("emails", "Hi,") %><% end %>

<%= refund_line(%{amount: @refund.amount, how: @refunded_to, format_currency: @format_currency}) %>

<%= message(@refund.note) %><%= dgettext("emails", "If you have any questions, just reply to this email.") %>

<%= dgettext("emails", "Warm wishes,") %>

<%= signature() %>
