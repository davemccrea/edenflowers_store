<%= if @order.customer_first_name do %><%= gettext("Hi %{name},", name: @order.customer_first_name) %><% else %><%= gettext("Hi,") %><% end %>

<%= if @refund.payment_method == :stripe do %><%= case @refunded_to do %><% {:card, brand, last4} -> %><%= gettext("I've refunded %{amount} to your %{brand} card ending in %{last4}.", amount: @format_currency.(@refund.amount), brand: brand, last4: last4) %><% :mobilepay -> %><%= gettext("I've refunded %{amount} to your MobilePay.", amount: @format_currency.(@refund.amount)) %><% :unknown -> %><%= gettext("I've refunded %{amount} the way you paid.", amount: @format_currency.(@refund.amount)) %><% end %><% else %><%= gettext("I've given you back %{amount}.", amount: @format_currency.(@refund.amount)) %><% end %>

<%= if @refund.note do %><%= @refund.note %>

<% end %><%= gettext("If you have any questions, just reply to this email.") %>

<%= gettext("Warm wishes,") %>

<%= signature() %>
