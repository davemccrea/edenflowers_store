<!DOCTYPE html>
<html lang={to_string(Localize.get_locale().cldr_locale_id)} class="w-full">
  <head>
    <meta charset="utf-8" />
    <%!-- maximum-scale stops admin zooming, both on pinch (Android) and on focusing a field smaller than 16px (iOS). --%>
    <meta
      name="viewport"
      content={
        if admin_path?(@conn.request_path),
          do: "width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover",
          else: "width=device-width, initial-scale=1, viewport-fit=cover"
      }
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="version" content={Edenflowers.Feedback.Note.app_version()} />
    <.live_title default="Store" suffix=" | Eden Flowers">
      {assigns[:page_title] || if(assigns[:status] == 404, do: ~t"Page not found")}
    </.live_title>
    <meta :if={assigns[:page_description]} name="description" content={@page_description} />
    <meta :if={assigns[:page_robots]} name="robots" content={@page_robots} />
    <link
      :if={!admin_path?(@conn.request_path) and assigns[:status] != 404}
      rel="canonical"
      href={Phoenix.VerifiedRoutes.unverified_url(@conn, @conn.request_path)}
    />
    <.hreflang_links :if={assigns[:alternates]} conn={@conn} alternates={@alternates} />
    <meta property="og:site_name" content="Eden Flowers" />
    <meta :if={assigns[:page_title]} property="og:title" content={"#{@page_title} | Eden Flowers"} />
    <meta :if={assigns[:page_description]} property="og:description" content={@page_description} />
    <meta :if={assigns[:og_image]} property="og:image" content={@og_image} />
    <.json_ld :if={assigns[:json_ld]} data={@json_ld} />

    <link rel="icon" type="image/png" href="/favicon-96x96.png?v=20261028" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261028" />
    <link rel="shortcut icon" href="/favicon.ico?v=20261028" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260506" />
    <meta name="theme-color" content="#BDCCC3" />
    <%!-- Admin pages install as their own app, opening on the Overview. --%>
    <%= if admin_path?(@conn.request_path) do %>
      <meta name="apple-mobile-web-app-title" content="Eden Admin" />
      <link rel="manifest" href="/admin.webmanifest?v=20261015" />
    <% else %>
      <meta name="apple-mobile-web-app-title" content="Eden Flowers" />
      <link rel="manifest" href="/site.webmanifest?v=20261015" />
    <% end %>

    <%!-- Runs before first paint so a reload doesn't start the home hero's animations it then skips. See the HomeHero hook. --%>
    <script>
      try {
        if (sessionStorage.getItem("hero-seen"))
          document.documentElement.classList.add("hero-seen");
      } catch {}
    </script>
    <%!-- Photos come from imgproxy on another host; opening that connection now saves a first visit's LCP photo the wait. --%>
    <link rel="preconnect" href={Application.get_env(:imgproxy, :prefix)} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body
    class="bg-base-100 flex min-h-screen flex-col antialiased"
    data-reviewer={reviewer?(@conn.assigns[:current_user])}
    data-reviewer-name={reviewer_name(@conn.assigns[:current_user])}
  >
    <a href="#main-content" class="skip-link">{~t"Skip to main content"}</a>
    {@inner_content}
  </body>
</html>
