<div class="flex flex-grow flex-col">
  <header class="flex justify-center py-8">
    <a href={~q"/#{language}"}>
      <img src={~p"/images/logo-eden-flowers.svg"} alt="Eden Flowers" width="160" height="80" class="w-40 md:hidden" />
      <img
        src={~p"/images/logo-eden-flowers-wide.svg"}
        alt="Eden Flowers"
        width="256"
        height="80"
        class="hidden w-64 md:block"
      />
    </a>
  </header>

  <main
    id="main-content"
    tabindex="-1"
    class="flex flex-grow justify-center px-6 pt-12 pb-20 outline-hidden md:pt-24"
  >
    <div class="text-base-content flex max-w-xl flex-col items-center gap-6 text-center text-lg">
      <h1 class="page-title">{~t"Page not found"}</h1>
      <p>{~t"The page you're looking for doesn't exist or has moved."}</p>
      <div class="flex flex-wrap justify-center gap-3">
        <.button href={~q"/#{language}"} variant="primary">{~t"Go to the home page"}</.button>
        <.button href={~q"/#{language}/store"}>{~t"Browse the store"}</.button>
      </div>
    </div>
  </main>
</div>
